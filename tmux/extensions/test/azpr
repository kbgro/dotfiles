#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$0")/../../.." && pwd)
SCRIPT="$ROOT/tmux/extensions/bin/azpr"
WORK=$(mktemp -d)
trap 'rm -rf -- "$WORK"' EXIT

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
assert_contains() {
    grep -F -- "$2" "$1" >/dev/null || {
        printf '%s\n' "$(<"$1")" >&2
        fail "$2 not found in $1"
    }
}

mkdir -p "$WORK/bin"
cat > "$WORK/bin/az" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$AZPR_TEST_LOG"
if [[ "$*" == repos\ pr\ list* ]]; then
    printf '123\tfeature/auth\trefs/heads/feature/auth\trefs/heads/develop\tactive\tqueued\n'
elif [[ "$*" == repos\ pr\ show* ]]; then
    printf 'Title: feature/auth\nMergeStatus: queued\n'
elif [[ "$*" == repos\ pr\ policy\ list* ]]; then
    printf 'Build validation\tapproved\n'
fi
EOF
cat > "$WORK/bin/fzf" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" > "$AZPR_FZF_ARGS"
while (($#)); do
    shift
done
cat >/dev/null
printf 'm\n123\tfeature/auth\n'
EOF
cat > "$WORK/bin/tmux" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$WORK/bin/az" "$WORK/bin/fzf" "$WORK/bin/tmux"

export PATH="$WORK/bin:$PATH"
export TMUX=1
export AZPR_TEST_LOG="$WORK/az.log"
export AZPR_FZF_ARGS="$WORK/fzf.args"

"$SCRIPT" --preview 123 >"$WORK/preview" 2>&1
assert_contains "$WORK/preview" 'Build validation'

printf 'y\n' | "$SCRIPT" >"$WORK/output" 2>&1
assert_contains "$WORK/fzf.args" '--preview='
assert_contains "$WORK/fzf.args" '--preview-window=right:65%'
assert_contains "$WORK/az.log" 'repos pr update --id 123 --status completed'

if "$SCRIPT" --help >"$WORK/help" 2>&1; then
    assert_contains "$WORK/help" 'Pick an active Azure DevOps pull request'
else
    fail '--help failed'
fi

printf 'azpr tests passed\n'
