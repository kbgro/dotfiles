#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$0")/../../.." && pwd)
SCRIPT="$ROOT/tmux/extensions/bin/azpr"
WORK=$(mktemp -d)
trap 'rm -rf -- "$WORK"' EXIT

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
assert_contains() {
    grep -F -- "$2" "$1" >/dev/null || {
        printf '%s\n' "$(<"$1")" >&2
        fail "$2 not found in $1"
    }
}

mkdir -p "$WORK/bin"
cat > "$WORK/bin/az" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$AZPR_TEST_LOG"
if [[ "$*" == repos\ pr\ list* ]]; then
    printf '123\tfeature/auth\trefs/heads/feature/auth\trefs/heads/develop\tactive\tqueued\n'
elif [[ "$*" == devops\ project\ list* ]]; then
    printf 'Payments\n'
elif [[ "$*" == repos\ pr\ show* ]]; then
    printf 'Title: feature/auth\nMergeStatus: queued\n'
elif [[ "$*" == repos\ pr\ policy\ list* ]]; then
    printf 'Build validation\tapproved\n'
fi
EOF
cat > "$WORK/bin/fzf" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" > "$AZPR_FZF_ARGS"
if [[ ! -e "$AZPR_PROJECT_PICKED" ]]; then
    : > "$AZPR_PROJECT_PICKED"
    cat >/dev/null
    printf 'Payments\n'
    exit 0
fi
while (($#)); do
    shift
done
cat >/dev/null
printf 'm\n123\tfeature/auth\n'
EOF
cat > "$WORK/bin/tmux" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$WORK/bin/az" "$WORK/bin/fzf" "$WORK/bin/tmux"

export PATH="$WORK/bin:$PATH"
export TMUX=1
export AZPR_TEST_LOG="$WORK/az.log"
export AZPR_FZF_ARGS="$WORK/fzf.args"
export AZPR_PROJECT_PICKED="$WORK/project-picked"

AZPR_PROJECT=Payments "$SCRIPT" --preview 123 >"$WORK/preview" 2>&1
assert_contains "$WORK/preview" 'Build validation'

printf 'y\n' | "$SCRIPT" >"$WORK/output" 2>&1
assert_contains "$WORK/fzf.args" '--preview='
assert_contains "$WORK/fzf.args" '--preview-window=right:65%'
assert_contains "$WORK/az.log" 'repos pr list --detect false --project Payments --status active'
assert_contains "$WORK/az.log" 'repos pr update --detect false --id 123 --project Payments --status completed'
assert_contains "$WORK/az.log" "devops project list --detect false --query value[].name --output tsv"

cat > "$WORK/bin/az" <<'EOF'
#!/usr/bin/env bash
printf 'Azure CLI request failed: configure organization and project\n' >&2
exit 1
EOF

if "$SCRIPT" >"$WORK/error-output" 2>&1; then
    fail 'Azure CLI failure was not reported'
fi
assert_contains "$WORK/error-output" 'Azure CLI request failed'

if "$SCRIPT" --help >"$WORK/help" 2>&1; then
    assert_contains "$WORK/help" 'Pick an active Azure DevOps pull request'
else
    fail '--help failed'
fi

printf 'azpr tests passed\n'
