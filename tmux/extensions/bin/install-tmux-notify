#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd -P)
BASHRC=${1:-$HOME/.bashrc}
SOURCE_LINE="source \"$SCRIPT_DIR/tmux-notify\""

touch "$BASHRC"
had_source=0
grep -Fqx -- "$SOURCE_LINE" "$BASHRC" && had_source=1 || true
TEMP_FILE=$(mktemp)
trap 'rm -f -- "$TEMP_FILE"' EXIT
inserted=0
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$SOURCE_LINE" ]] && continue
    if (( ! inserted )) && [[ "$line" == *SDKMAN* || "$line" == *sdkman-init.sh* ]]; then
        printf '\n# Notify tmux when long-running Bash commands finish.\n%s\n\n' \
            "$SOURCE_LINE" >> "$TEMP_FILE"
        inserted=1
    fi
    printf '%s\n' "$line" >> "$TEMP_FILE"
done < "$BASHRC"
if (( ! inserted )); then
    printf '\n# Notify tmux when long-running Bash commands finish.\n%s\n\n' \
        "$SOURCE_LINE" >> "$TEMP_FILE"
fi
mv -- "$TEMP_FILE" "$BASHRC"
if (( ! had_source )); then
    printf 'Added tmux command notifications to %s\n' "$BASHRC"
else
    printf 'Updated tmux command notifications in %s\n' "$BASHRC"
fi
