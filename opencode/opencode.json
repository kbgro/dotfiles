{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "git *": "allow",
            "git commit *": "ask",
            "npm *": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "cat *": "allow",
            "mkdir *": "allow",
            "touch *": "allow"
        },
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny"
        },
        "skill": {
            "*": "allow",
            "internal-*": "deny",
            "experimental-*": "ask"
        }
    },
}
